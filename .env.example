# Mission Control - Local environment
# Copy to .env.local and fill in your values

# ─── Public URL ───────────────────────────────────────────────────────────────
# Public-facing base URL used in MCP tool responses and push notification links.
# Set this to your actual hostname when not running on localhost.
# NEXTAUTH_URL=https://mc.example.com
# NEXT_PUBLIC_BASE_URL=https://mc.example.com

# ─── Native APNs delivery ─────────────────────────────────────────────────────
# Keep provider and encryption keys in the deployment secret store. Generate
# APNS_TOKEN_ENCRYPTION_KEY with 32 random bytes encoded as base64.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY_P8_BASE64=
# APNS_TOPIC=com.example.missioncontrol
# APNS_ENVIRONMENT=production
# APNS_TOKEN_ENCRYPTION_KEY=

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: trace, debug, info, warn, error, fatal (default: info in production, debug in dev)
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
# Supported values: sqlite (default) or postgres.
# MC_DATABASE_BACKEND=sqlite
# MC_WORKER_HEALTH_QUERY_TIMEOUT_MS=5000
MC_DB_PATH=./data/mission-control.db
# PostgreSQL credentials are server-only deployment secrets. Keep the URL in
# the deployment secret store; never expose it through a NEXT_PUBLIC_ variable.
# MC_POSTGRES_URL=postgres://mission_control:replace-me@postgres.example/mission_control
# PostgreSQL verifies the server certificate by default. Use `disable` only for
# a trusted local development or disposable integration-test database.
# MC_POSTGRES_SSL_MODE=verify-full
# MC_POSTGRES_MIN_CONNECTIONS=0
# MC_POSTGRES_MAX_CONNECTIONS=10
# MC_POSTGRES_IDLE_TIMEOUT_MS=30000
# MC_POSTGRES_CONNECTION_TIMEOUT_MS=10000
# MC_POSTGRES_STATEMENT_TIMEOUT_MS=30000
# MC_POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=30000
# MC_POSTGRES_APPLICATION_NAME=mission-control-web
# Locks an internet-facing instance to seeded, disposable data and blocks
# credentials, integrations, synchronization, and outbound write-back.
# MC_PUBLIC_DEMO=true

# ─── Alertmanager webhook intake ──────────────────────────────────────────────
# Required scoped bearer token for POST /api/integrations/alertmanager/webhook.
# Generate at least 32 random characters and keep it in the deployment secret store.
# MC_ALERTMANAGER_WEBHOOK_TOKEN=
# Stable incident namespace used in {integration}:alertmanager:{fingerprint}.
# MC_ALERTMANAGER_INTEGRATION_ID=homelab

# ─── Connector sync isolation and telemetry ──────────────────────────────────
# Compose sets worker mode automatically. For local worker-mode testing, start
# both `npm run dev` and `npm run worker` against the same database.
# MC_SYNC_EXECUTION_MODE=worker
# MC_SYNC_JOB_LEASE_MS=120000
# MC_SYNC_JOB_MAX_ATTEMPTS=3
# MC_SYNC_JOB_RETRY_BASE_MS=30000
# MC_SYNC_API_WAIT_TIMEOUT_MS=900000
# MC_SYNC_DURATION_BUDGET_MS=300000
# MC_SYNC_WORKER_ABORT_GRACE_MS=30000
# MC_SYNC_WORKER_SHUTDOWN_GRACE_MS=30000
# Optional: unset derives max(sync budget + 60s, lease * 2).
# MC_WORKER_HEALTH_STALE_MS=
# MC_EVENT_LOOP_LAG_THRESHOLD_MS=200
# MC_EVENT_LOOP_LAG_SUSTAINED_SAMPLES=3
# MC_TELEMETRY_INTERVAL_MS=10000
# MC_HEALTHCHECK_START_DEADLINE_MS=60000
# MC_DB_BUSY_TIMEOUT_MS=5000
# MC_DB_BUSY_WAIT_WARNING_MS=100
# MC_DB_SLOW_OPERATION_MS=100
# MC_DB_LATENCY_P95_WARNING_MS=100
# MC_DB_LATENCY_P99_CRITICAL_MS=500
# MC_DB_WAL_WARNING_BYTES=67108864
# MC_DB_WAL_CRITICAL_BYTES=268435456
# MC_DB_CHECKPOINT_STARVATION_MS=60000
# MC_DB_CHECKPOINT_PENDING_FRAMES=1000
# MC_DB_CHECKPOINT_PROBE_INTERVAL_MS=60000
# MC_DB_OBSERVATION_WINDOW_MS=300000
# MC_DB_MAX_SAMPLES=1000
# MC_DB_MAX_SLOW_OPERATIONS=10

# ─── Microsoft Graph API (for Todo, Email, Calendar) ─────────────────────────
# Supports multiple accounts (personal + work) via OAuth2
#
# Single app registration (simplest — Microsoft multi-tenant app handles both account types):
MS_CLIENT_ID=
MS_TENANT_ID=consumers
MS_REDIRECT_URI=http://localhost:3099/api/auth/microsoft/callback
# For work accounts, use tenant "organizations" or your specific tenant ID
# The OAuth flow handles account selection automatically
#
# Authentication: Certificate (recommended) or Client Secret
# If your tenant blocks client secrets, use certificate-based auth instead.
#
# Certificate auth (preferred when tenant policy blocks secrets):
#   1. Generate a self-signed certificate and upload .cer to the App Registration
#   2. Provide the SHA-1 thumbprint (hex, no colons) and private key below
MS_CERT_THUMBPRINT=
MS_CERT_PRIVATE_KEY_PATH=
# Or provide the PEM key inline (use \n for newlines):
# MS_CERT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
#
# Public client / PKCE (use when tenant blocks BOTH secrets and certificates):
#   Enable "Allow public client flows" in the app registration's Authentication settings.
#   No secret or certificate needed — auth uses PKCE code challenge instead.
MS_PUBLIC_CLIENT=
MS_PUBLIC_CLIENT_PERSONAL=
MS_PUBLIC_CLIENT_WORK=
#
# Client secret (alternative — only if tenant allows it):
MS_CLIENT_SECRET=
#
# Separate app registrations per account type (optional — override above values):
# When set, personal connectors use MS_CLIENT_ID_PERSONAL and work connectors use
# MS_CLIENT_ID_WORK. Falls back to MS_CLIENT_ID / MS_CLIENT_SECRET when absent.
MS_CLIENT_ID_PERSONAL=
MS_CLIENT_SECRET_PERSONAL=
MS_CERT_THUMBPRINT_PERSONAL=
MS_CERT_PRIVATE_KEY_PATH_PERSONAL=
MS_CLIENT_ID_WORK=
MS_CLIENT_SECRET_WORK=
MS_CERT_THUMBPRINT_WORK=
MS_CERT_PRIVATE_KEY_PATH_WORK=

# ─── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_PAT=
GITHUB_REPOS=

# ─── Triage Queue Imports ────────────────────────────────────────────────────
# Used by /api/triage/import/github-stars and /api/triage/import/reddit-saved
# Twitter archive ZIP safety budgets (bytes unless noted; defaults are conservative).
# MC_TWITTER_ARCHIVE_MAX_REQUEST_BYTES=135266304
# MC_TWITTER_ARCHIVE_MAX_ENTRY_COUNT=10000
# MC_TWITTER_ARCHIVE_MAX_ENTRY_EXPANDED_BYTES=8388608
# MC_TWITTER_ARCHIVE_MAX_TOTAL_EXPANDED_BYTES=67108864
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
# Optional if omitted: resolved from /api/v1/me during import
REDDIT_USERNAME=
# Used by /api/triage/import/youtube — Google OAuth client with YouTube Data API v3 access
MC_YOUTUBE_CLIENT_ID=
MC_YOUTUBE_CLIENT_SECRET=
MC_YOUTUBE_REFRESH_TOKEN=
# Optional comma-separated playlist IDs; defaults to Watch Later (WL) and Liked Videos (LL)
MC_YOUTUBE_PLAYLIST_IDS=
# Optional shared secret for iOS Shortcut/browser extension capture endpoint:
# send as `x-capture-key`, `x-triage-capture-key`, or a bearer token
MC_TRIAGE_CAPTURE_KEY=
# Image capture uploads default to 10 MiB and local storage under data/captures/
CAPTURE_IMAGE_MAX_BYTES=10485760
# CAPTURE_IMAGE_STORAGE_PATH=/absolute/path/to/captures
# iCloud sharing link for the iOS Shortcut (used by /api/shortcut/version)
MC_SHORTCUT_INSTALL_URL=https://mission-control.example/shortcut/install

# ─── Bug Snap Widget ──────────────────────────────────────────────────────────
# Shared secret for the embeddable bug-snap widget (falls back to MC_TRIAGE_CAPTURE_KEY if unset)
MC_BUG_SNAP_KEY=

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Supported: openai, azure, ollama, bifrost
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.1:8b
# Meaning-based search enrichment is feature-scoped and disabled by default.
# Saved settings take precedence over these environment fallbacks.
AI_SEMANTIC_SEARCH_ENABLED=false
# Ollama provider admission control. Requests beyond concurrency wait in the
# bounded queue, then receive a retryable 503 when the queue is full.
MC_AI_OLLAMA_CONCURRENCY=2
MC_AI_OLLAMA_QUEUE_LENGTH=8
MC_AI_PROVIDER_TIMEOUT_MS=120000
# Embeddings route independently from completions. Bifrost to Azure OpenAI is
# recommended; use the Azure deployment name after the provider prefix.
AI_EMBEDDING_PROVIDER=bifrost
AI_EMBEDDING_MODEL=azure/text-embedding-3-small
# Optional route-specific overrides. Provider-specific BIFROST_*, AZURE_OPENAI_*,
# and OPENAI_API_KEY values remain the fallback when these are blank.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
MC_EMBEDDING_REQUEST_TIMEOUT_MS=20000
MC_EMBEDDING_REQUEST_MAX_RETRIES=2
MC_EMBEDDING_REQUEST_RETRY_BASE_MS=100
# Interactive query vectors are process-local only. Successful vectors are
# retained briefly in a bounded TTL/LRU; failed requests are never cached.
MC_QUERY_EMBEDDING_CACHE_MAX_ENTRIES=128
MC_QUERY_EMBEDDING_CACHE_TTL_MS=300000
# Semantic vectors use Float32 storage in an LRU bounded by both limits.
MC_SEMANTIC_CACHE_MAX_ENTRIES=2048
MC_SEMANTIC_CACHE_MAX_BYTES=33554432
# Maximum compatible, live rows scored per semantic query.
MC_SEMANTIC_SEARCH_MAX_CANDIDATES=2000
OPENAI_API_KEY=
BIFROST_BASE_URL=
BIFROST_API_KEY=
# Durable AI runs are executed by a registered provider-neutral worker adapter.
# Generate the provider session key with: openssl rand -base64 32
MC_AI_PROVIDER_SESSION_KEY=
# MC_AI_PROVIDER_SESSION_KEY_VERSION=v1
# MC_AI_RUN_LEASE_MS=120000
# MC_AI_RUN_CLEANUP_TIMEOUT_MS=60000
# MC_AI_RUN_RETRY_BASE_MS=5000
# MC_AI_RUN_RETRY_TIMEOUT_MS=900000
# MC_AI_RUN_WORKER_POLL_MS=500
# MC_AI_RUN_PRUNE_INTERVAL_MS=21600000
# Retention defaults: standard 30d, restricted 7d, local-only 1d.
# MC_AI_RUN_RETENTION_DAYS_STANDARD=30
# MC_AI_RUN_RETENTION_DAYS_RESTRICTED=7
# MC_AI_RUN_RETENTION_DAYS_LOCAL_ONLY=1
# Comma-separated custom Azure AI hostnames trusted as private deployments.
AI_APPROVED_AZURE_HOSTS=
# Comma-separated custom Bifrost/OpenAI hostnames trusted to receive AI data.
AI_APPROVED_BIFROST_HOSTS=
AI_APPROVED_OPENAI_HOSTS=
# For OpenAI: AI_PROVIDER=openai, set OPENAI_API_KEY
# For Azure: AI_PROVIDER=azure, set AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT
# For Bifrost: AI_PROVIDER=bifrost, set BIFROST_BASE_URL + BIFROST_API_KEY

# ─── Tyrion (Monarch Money bridge for Mission Control) ────────────────────
# Each connector stores its Tyrion Bridge API base URL. Production defaults to
# https://tyrion.example/api/connector/v1; custom HTTPS and safe private/local
# HTTP bridge bases can be entered in connector setup.
# Optional server-side fallback. Users can instead enter BRIDGE_API_TOKEN during
# connector setup; persisted credentials are never returned to browser clients.
FINANCE_MANAGER_API_TOKEN=

# Protected Tyrion Finance Insights T1 service. The server uses the persisted
# Finance Manager credential with FINANCE_MANAGER_API_TOKEN as fallback and a
# fixed private service authority; there is intentionally no URL override.
# Publication currency comes only from the connector's persisted householdCurrency.
# TYRION_FINANCE_INSIGHTS_TIMEOUT_MS=10000
# TYRION_FINANCE_INSIGHTS_MAX_RETRIES=2
TYRION_FINANCE_INSIGHTS_SHADOW_INGEST_ENABLED=false

# Protected Tyrion batch attribution v2 service. Mission Control calls the fixed
# tyrion-operations-ui service DNS and reuses FINANCE_MANAGER_API_TOKEN as Bearer auth.
# The persisted token is authentication only. Stable opaque source/account refs
# come from protected per-connector state.
# Required static mutable-policy fence for normal sync and operator readiness.
# This is independent of attribution contractVersion 2.0.
TYRION_ATTRIBUTION_EXPECTED_POLICY_VERSION=2
TYRION_ATTRIBUTION_TIMEOUT_MS=10000
# Public, browser-safe operational links. TYRION_OPERATIONS_URL must be an
# allowlisted HTTPS root with no path, query, fragment, or credentials. Mission
# Control constructs the reconnect destination as ?source=mission-control.
# These values are never used for service authentication or internal calls.
MONARCH_WEB_URL=https://app.monarchmoney.com
TYRION_OPERATIONS_URL=https://tyrion.example
# Extra HTTPS hosts permitted for the two public links above.
FINANCE_EXTERNAL_ALLOWED_HOSTS=

# ─── OWL (Paperless-ngx connector and document agent) ────────────────────
DOC_INTELLIGENCE_URL=http://localhost:8200
DOC_INTELLIGENCE_API_KEY=
# Paperless-ngx system-of-record URL (for linking to the document viewer)
PAPERLESS_BASE_URL=http://localhost:8000
# Extra HTTPS hosts permitted for mapped OWL document actions.
FINANCE_OWL_ALLOWED_HOSTS=

# ─── RyMessage (desktop iMessage client with Action Center) ──────────────
# Mode: 'rest' (RyMessage HTTP API) or 'sqlite' (direct DB read)
RYMESSAGE_MODE=rest
RYMESSAGE_API_URL=http://localhost:1234/api/v1
RYMESSAGE_API_KEY=
# For SQLite mode:
# RYMESSAGE_DB_PATH=C:/Users/example-user/AppData/Roaming/com.rymessage.app/rymessage.db

# ─── Home Assistant ───────────────────────────────────────────────────────
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=
# Entity patterns to monitor (comma-separated globs)
HOME_ASSISTANT_ENTITIES=sensor.mail_*,binary_sensor.*_door*,sensor.*_battery
