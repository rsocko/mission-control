{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-control.example/schemas/work-todo-pull-response-1.0.json",
  "title": "Mission Control work To Do pull response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "connectorInstanceId",
    "syncTimestamp",
    "isFullSnapshot",
    "lists"
  ],
  "properties": {
    "schemaVersion": {
      "enum": ["1.0"]
    },
    "connectorInstanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "syncTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "isFullSnapshot": {
      "enum": [true]
    },
    "lists": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "tasks"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "wellKnownListName": {
            "type": ["string", "null"],
            "maxLength": 100
          },
          "isOwner": {
            "type": ["boolean", "null"]
          },
          "isShared": {
            "type": ["boolean", "null"]
          },
          "tasks": {
            "type": "array",
            "maxItems": 999,
            "items": {
              "$ref": "#/$defs/task"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dateTimeValue": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["dateTime", "timeZone"],
      "properties": {
        "dateTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "importance",
        "createdDateTime",
        "lastModifiedDateTime"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "enum": ["notStarted", "inProgress", "completed", "waitingOnOthers", "deferred"]
        },
        "importance": {
          "enum": ["low", "normal", "high"]
        },
        "body": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["content", "contentType"],
          "properties": {
            "content": {
              "type": "string",
              "maxLength": 20000
            },
            "contentType": {
              "enum": ["text", "html"]
            }
          }
        },
        "createdDateTime": {
          "type": "string",
          "format": "date-time"
        },
        "lastModifiedDateTime": {
          "type": "string",
          "format": "date-time"
        },
        "completedDateTime": {
          "$ref": "#/$defs/dateTimeValue"
        },
        "dueDateTime": {
          "$ref": "#/$defs/dateTimeValue"
        },
        "isReminderOn": {
          "type": ["boolean", "null"]
        },
        "reminderDateTime": {
          "$ref": "#/$defs/dateTimeValue"
        }
      }
    }
  }
}
