MC_APP_BUNDLE_IDENTIFIER = com.example.missioncontrol
MC_WEB_BASE_URL = https:/$()/mission-control.example
MC_APP_GROUP_IDENTIFIER = group.$(MC_APP_BUNDLE_IDENTIFIER)
MC_KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(MC_APP_BUNDLE_IDENTIFIER).shared
MC_KEYCHAIN_SERVICE = $(MC_APP_BUNDLE_IDENTIFIER).share-capture
MC_INSTALLATION_KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(MC_APP_BUNDLE_IDENTIFIER).app
MC_INSTALLATION_KEYCHAIN_SERVICE = $(MC_APP_BUNDLE_IDENTIFIER).installation
MC_APNS_ENVIRONMENT = production
MC_APNS_TOPIC = $(MC_APP_BUNDLE_IDENTIFIER)

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER = $(MC_APP_PROVISIONING_PROFILE_SPECIFIER)
