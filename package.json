{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-service.mjs run mission-control",
    "dev:uncapped": "node scripts/dev-service.mjs run mission-control --uncapped",
    "dev:services": "node scripts/dev-service.mjs list",
    "dev:status": "node scripts/dev-service.mjs list",
    "dev:stop": "node scripts/dev-service.mjs stop",
    "dev:lifecycle": "node scripts/dev-server-manager.mjs",
    "dev:orphan-scan": "node scripts/dev-server-manager.mjs scan",
    "build": "npm run build:worker && npm run build:identity-operator && next build && npm run package:worker",
    "build:worker": "node scripts/build-sync-worker.mjs",
    "build:identity-operator": "node scripts/build-github-identity-operator.mjs",
    "package:worker": "node scripts/package-sync-worker-runtime.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker-runtime": "npm run build:worker && npm run build:identity-operator && node scripts/smoke-sync-worker-runtime.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/seed.ts",
    "github:bulk-transfer": "node --conditions=react-server --import tsx scripts/github-bulk-issue-transfer.ts",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "test:dev-services": "node --test scripts/dev-service.test.mjs",
    "ci:workflows": "node scripts/validate-workflows.mjs",
    "impeccable:validate": "node scripts/validate-impeccable.mjs",
    "impeccable:audit": "node .github/skills/impeccable/scripts/detect.mjs --no-advisory src",
    "mcp": "tsx src/mcp/server.ts",
    "worker": "tsx src/sync-worker.ts"
  },
