{
  "id": "/",
  "name": "Mission Control",
  "short_name": "MissionCtrl",
  "description": "Personal task & alert aggregation system",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#2563eb",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "url": "/today",
      "description": "View today's tasks",
      "icons": [
        { "src": "/icons/shortcut-today.svg", "sizes": "96x96", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "Triage",
      "short_name": "Triage",
      "url": "/triage",
      "description": "Triage incoming alerts",
      "icons": [
        { "src": "/icons/shortcut-triage.svg", "sizes": "96x96", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "Projects",
      "short_name": "Projects",
      "url": "/projects",
      "description": "View all projects",
      "icons": [
        { "src": "/icons/shortcut-projects.svg", "sizes": "96x96", "type": "image/svg+xml" }
      ]
    }
  ],
  "share_target": {
    "action": "/capture",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/jpeg", "image/png", "image/webp", "image/heic"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
