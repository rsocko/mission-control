{
  "name": "@rsocko/icon-picker",
  "version": "0.1.0-rc.2",
  "description": "Framework-neutral React icon picker with portable icon values",
  "license": "MIT",
  "author": "Ryan Sockalosky",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./picker": {
      "types": "./dist/picker.d.ts",
      "import": "./dist/picker.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsocko/icon-picker.git"
  },
  "bugs": {
    "url": "https://github.com/rsocko/icon-picker/issues"
  },
  "homepage": "https://github.com/rsocko/icon-picker#readme",
  "keywords": [
    "react",
    "icon",
    "picker",
    "emoji",
    "lucide",
    "iconify",
    "simple-icons"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:verify": "node scripts/verify-demo.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "package:artifact": "npm run build && node scripts/create-package-artifact.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run demo:build && npm run demo:verify && npm run package:verify",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "dependencies": {
    "emoji-picker-react": "^4.19.1",
    "emojilib": "^4.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.10.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
